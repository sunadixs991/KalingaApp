{
  "expo": {
    "name": "Kalinga",
    "slug": "Kalinga-App",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/Kalinga_logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": "1.0.0",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.kalingaapp"
    },
    "android": {
      "icon": "./assets/kalinga-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/kalinga-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.yourcompany.kalingaapp",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "NOTIFICATIONS",
        "SMS"
      ],
      "googleServicesFile": "./google-services.json",
      "useNextNotificationsApi": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/kalinga-icon.png",
          "color": "#e75e33",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Kalinga"
        }
      ],
      "expo-asset"
    ],
    "notification": {
      "icon": "./assets/kalinga-icon.png",
      "color": "#e75e33",
      "androidMode": "default",
      "androidCollapsedTitle": "Kalinga"
    },
    "scheme": "kalingaapp",
    "updates": {
      "url": "https://u.expo.dev/a00ebb60-4678-4296-acd5-82fde80bea41"
    },
    "extra": {
      "eas": {
        "projectId": "b5d643b6-d684-49b9-8551-b7a5ed7fad3d"
      }
    }
  }
}
