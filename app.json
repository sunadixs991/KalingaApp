{
  "expo": {
    "name": "Kalinga",
    "slug": "Kalinga-App",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/Kalinga_logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": "1.0.0",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "icon": "./assets/kalinga-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/kalinga-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sunadixs98.kalingaapp",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "USE_FULL_SCREEN_INTENT",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 34,
            "buildToolsVersion": "35.0.0",
            "enableDexingArtifactTransform": false
          }
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "development"
        }
      ]
    ],
    "scheme": "kalingaapp",
    "updates": {
      "url": "https://u.expo.dev/a00ebb60-4678-4296-acd5-82fde80bea41"
    },
    "extra": {
      "eas": {
        "projectId": "b5d643b6-d684-49b9-8551-b7a5ed7fad3d"
      },
      "oneSignalAppId": "518decd3-401f-4f61-b27f-b5a2db3e5a1a"
    },
    "owner": "bhean199"
  }
}